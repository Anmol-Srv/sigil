{
  "name": "@anmol-srv/sigil",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "description": "Local-first memory for AI coding agents. PGlite by default, explicit atomic saves, deterministic hybrid recall, and no telemetry.",
  "bin": {
    "sigil": "dist/cli.js"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "node build.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "test:reliability": "node test/reliability/run.js",
    "db:test:up": "docker compose up -d db",
    "db:test:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "prompts/",
    "src/db/migrations/",
    "src/db/drivers/",
    "src/gui/web/",
    "integrations/",
    "knexfile.js",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "sigil",
    "memory",
    "ai-memory",
    "persistent-memory",
    "agent-memory",
    "long-term-memory",
    "shared-memory",
    "ai-agent",
    "coding-agent",
    "ai-infrastructure",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "codex",
    "codex-cli",
    "cursor",
    "kiro",
    "windsurf",
    "continue-dev",
    "cline",
    "chatgpt",
    "ollama",
    "rag",
    "knowledge-base",
    "vector-search",
    "hybrid-search",
    "llm",
    "context",
    "pgvector",
    "postgres",
    "local-first"
  ],
  "author": "Anmol Srivastava",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anmol-Srv/sigil.git"
  },
  "homepage": "https://github.com/Anmol-Srv/sigil#readme",
  "bugs": {
    "url": "https://github.com/Anmol-Srv/sigil/issues"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "knex": "^3.1.0",
    "pg": "^8.20.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@electric-sql/pglite": "^0.4.4"
  },
  "devDependencies": {
    "@clack/prompts": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.3",
    "globals": "^17.7.0",
    "lodash-es": "^4.17.23",
    "nanoid": "^5.1.7",
    "vitest": "^4.0.18",
    "zod": "^3.24.0"
  }
}
